export HISTFILE=${HOME}/.zsh_history
export HISTSIZE=1000
export SAVEHIST=10000
setopt hist_ignore_dups

autoload -U compinit
compinit
setopt auto_cd
setopt auto_pushd
setopt no_beep
autoload -U colors; colors
setopt prompt_subst

# git branch (vcs_info is zsh's built-in, faster/more correct than a
# hand-rolled `git branch` parse; message is empty outside a git repo)
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats "%{${fg[green]}%} (%b)%{${reset_color}%}"
precmd() { vcs_info }

# ssh-add -l summary (key count, 🔑 icon); empty when no agent or no keys
# loaded, so it doesn't clutter the prompt when unused. Exit status must be
# checked rather than just counting lines -- "no identities" goes to stdout
# too, so a naive line count misreports it as 1 key.
ssh_agent_prompt_info() {
  local output st n
  output=$(ssh-add -l 2>/dev/null)
  st=$?
  [ "$st" -eq 0 ] || return
  n=$(print -r -- "$output" | grep -c '^')
  print -n "%{${fg[yellow]}%} \U0001F511${n}%{${reset_color}%}"
}

# SSHログイン時は先頭にホスト名を追加
tmp_host_prefix=""
[ -n "${REMOTEHOST}${SSH_CONNECTION}" ] &&
  tmp_host_prefix="%{${fg[white]}%}${HOST%%.*} %{${reset_color}%}"

# 1行にディレクトリ/git/sshキー/直前コマンドの終了ステータス(非0時のみ)/
# ユーザーを詰める。右プロンプト(RPROMPT)は使わない -- コピペ時に右側の
# テキストが混ざるのが煩わしかったため
tmp_prompt=${tmp_host_prefix}'%{${fg[blue]}%}%~%{${reset_color}%}${vcs_info_msg_0_}$(ssh_agent_prompt_info)%(?. .%{${fg[red]}%}[%?]%{${reset_color}%} )%{${fg[cyan]}%}%n%# %{${reset_color}%}'
tmp_prompt2="%{${fg[cyan]}%}%_> %{${reset_color}%}"
tmp_sprompt="%{${fg[yellow]}%}%r is correct? [Yes, No, Abort, Edit]:%{${reset_color}%}"

# rootユーザ時(太字にしアンダーバー
if [ ${UID} -eq 0 ]; then
  tmp_prompt="%B%U${tmp_prompt}%u%b"
  tmp_prompt2="%B%U${tmp_prompt2}%u%b"
  tmp_sprompt="%B%U${tmp_sprompt}%u%b"
fi

PROMPT=$tmp_prompt    # 通常のプロンプト(ディレクトリ/git/sshキー/ユーザーを1行に)
PROMPT2=$tmp_prompt2  # セカンダリのプロンプト(コマンドが2行以上の時に表示される)
SPROMPT=$tmp_sprompt  # スペル訂正用プロンプト
;

